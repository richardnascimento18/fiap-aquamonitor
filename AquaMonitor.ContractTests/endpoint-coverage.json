      "id": "AUTH-01",
      "method": "POST",
      "route": "/api/Auth/register",
      "authorization": "Anonymous",
      "request": "name, email (valid), password (8..1024); role ignored",
      "businessRule": "Unique normalized email; creates User; returns token without password",
      "positive": {
        "test": "AUTH01_Success",
        "status": 201,
        "schema": "auth-response",
        "emptyBody": false
      },
      "negative": {
        "test": "AUTH01_Failure",
        "case": "Duplicate registration",
        "status": 409,
        "schema": "message-error",
        "emptyBody": false
      }
    },
