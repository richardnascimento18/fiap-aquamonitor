{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aquamonitor.test/contracts/validation-error.schema.json",
  "type": "object",
  "properties": {
    "message": {
      "const": "Dados invalidos."
    },
    "errors": {
      "oneOf": [
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    }
  },
  "required": [
    "message",
    "errors"
  ],
  "additionalProperties": false
}
