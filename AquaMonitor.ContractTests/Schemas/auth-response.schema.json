{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aquamonitor.test/contracts/auth-response.schema.json",
  "type": "object",
  "properties": {
    "token": {
      "type": "string",
      "minLength": 50,
      "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "role": {
      "type": "string",
      "enum": [
        "User",
        "Admin"
      ]
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "token",
    "name",
    "email",
    "role",
    "expiresAt"
  ],
  "additionalProperties": false
}
