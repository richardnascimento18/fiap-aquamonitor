{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aquamonitor.test/contracts/report-response.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "year": {
      "type": "integer",
      "minimum": 2000,
      "maximum": 2100
    },
    "month": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12
    },
    "totalConsumptionM3": {
      "type": "number",
      "minimum": 0
    },
    "savedWaterM3": {
      "type": "number"
    },
    "leaksDetected": {
      "type": "integer",
      "minimum": 0
    },
    "leaksResolved": {
      "type": "integer",
      "minimum": 0
    },
    "reductionPercent": {
      "type": "number"
    },
    "mitigationPlan": {
      "type": "string",
      "maxLength": 2000
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "generatedByUser": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "title",
    "year",
    "month",
    "totalConsumptionM3",
    "savedWaterM3",
    "leaksDetected",
    "leaksResolved",
    "reductionPercent",
    "mitigationPlan",
    "generatedAt",
    "generatedByUser"
  ],
  "additionalProperties": false
}
