{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aquamonitor.test/contracts/paged-readings.schema.json",
  "type": "object",
  "properties": {
    "data": {
      "type": "array",
      "items": {
        "$ref": "https://aquamonitor.test/contracts/reading-response.schema.json"
      }
    },
    "page": {
      "type": "integer",
      "minimum": 1
    },
    "pageSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "totalCount": {
      "type": "integer",
      "minimum": 0
    },
    "totalPages": {
      "type": "integer",
      "minimum": 0
    },
    "hasNextPage": {
      "type": "boolean"
    },
    "hasPreviousPage": {
      "type": "boolean"
    }
  },
  "required": [
    "data",
    "page",
    "pageSize",
    "totalCount",
    "totalPages",
    "hasNextPage",
    "hasPreviousPage"
  ],
  "additionalProperties": false
}
