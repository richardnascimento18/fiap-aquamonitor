{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aquamonitor.test/contracts/alert-response.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High",
        "Critical"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "Open",
        "Acknowledged",
        "Resolved"
      ]
    },
    "triggerFlowRate": {
      "type": "number",
      "minimum": 0
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "resolvedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "sensorId": {
      "type": "integer",
      "minimum": 1
    },
    "sensorName": {
      "type": "string",
      "minLength": 1
    },
    "sensorLocation": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "message",
    "severity",
    "status",
    "triggerFlowRate",
    "createdAt",
    "resolvedAt",
    "sensorId",
    "sensorName",
    "sensorLocation"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "Resolved"
          }
        }
      },
      "then": {
        "properties": {
          "resolvedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "else": {
        "properties": {
          "resolvedAt": {
            "type": "null"
          }
        }
      }
    }
  ]
}
