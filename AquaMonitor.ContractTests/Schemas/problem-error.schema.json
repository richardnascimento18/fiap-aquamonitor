{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aquamonitor.test/contracts/problem-error.schema.json",
  "type": "object",
  "required": [
    "title",
    "status",
    "detail"
  ],
  "properties": {
    "type": {
      "type": "string",
      "format": "uri"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "integer",
      "enum": [
        409,
        500
      ]
    },
    "detail": {
      "type": "string",
      "minLength": 1
    },
    "instance": {
      "type": "string"
    },
    "traceId": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
