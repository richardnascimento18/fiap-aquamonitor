# Supply a newly generated signing secret, e.g. openssl rand -base64 48.
# dotnet run does not load this file automatically; export variables or use user secrets.
Jwt__Key=
Jwt__Issuer=AquaMonitor.API
Jwt__Audience=AquaMonitor.Client
Jwt__ExpiresInHours=8
ConnectionStrings__DefaultConnection=/app/data/aquamonitor.db
ASPNETCORE_ENVIRONMENT=Production
BootstrapAdmin__Enabled=false
# Development-only, explicit opt-in; supply credentials privately when enabled.
BootstrapAdmin__Email=
BootstrapAdmin__Password=
# Optional exact browser origin, no trailing slash or wildcard.
# Cors__AllowedOrigins__0=https://client.example.com
