{
  "ConnectionStrings": {
    "DefaultConnection": "aquamonitor.db"
  },
  "Jwt": {
    "Issuer": "AquaMonitor.API",
    "Audience": "AquaMonitor.Client",
    "ExpiresInHours": "8"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "BootstrapAdmin": {
    "Enabled": false
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
